{
  "name": "@hyvnt/hyvui",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && node scripts/prepare-package.mjs && publint",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "check": "npm run tokens:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:next": "tsx --test tests/foundation.test.ts tests/docs-contract.test.ts tests/next-core.test.ts tests/next-visual-core.test.ts tests/next-art-direction.test.ts tests/next-measured-sublime.test.ts tests/next-biome-gallery.test.ts tests/next-biomes.test.ts tests/next-biome-composition.test.ts tests/next-frames.test.ts tests/next-passages.test.ts tests/next-biome-materials.test.ts tests/next-biome-manifest.test.ts tests/showcase-manifest.test.ts tests/showcase-navigation.test.ts tests/showcase-route-matrix.test.mjs tests/next-witness.test.ts tests/next-agent-bakeoff.test.ts tests/next-capabilities.test.ts tests/next-inspector.test.ts scripts/collect-component-surface.test.mjs scripts/measure-compositions.test.mjs",
    "measure:showcase": "tsx scripts/measure-showcase-routes.mjs",
    "inspect:next": "tsx scripts/inspect-composition.ts",
    "bakeoff:next": "node scripts/run-biome-bakeoff.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test:e2e": "npm run build && playwright test"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/next-experiments",
    "!dist/next-experiments/**",
    "!dist/next-lab",
    "!dist/next-lab/**",
    "!dist/showcase",
    "!dist/showcase/**",
    "!dist/examples",
    "!dist/examples/**",
    "llms.txt",
    "SKILL.md",
    "AESTHETICS.md",
    "COMPONENTS.md",
    "INSTALL.md",
    "docs/api",
    "docs/actions.md",
    "docs/copy-voice.md",
    "docs/depth.md",
    "docs/expressions.md",
    "docs/fonts.md",
    "docs/migration-v1.md",
    "docs/overlay-contract.md",
    "docs/recipes.md",
    "docs/research/browser-foundation-recon.md",
    "docs/registers.md",
    "docs/tokens.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles": "./dist/styles.css",
    "./themes.css": "./dist/themes.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens/hextech.css": "./dist/tokens/hextech.css",
    "./tokens/arcane.css": "./dist/tokens/arcane.css",
    "./tokens/base.css": "./dist/tokens/tokens.css",
    "./register.css": "./dist/system/register.css"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "motion": "^12.39.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "publint": "^0.3.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^7.0.4",
    "vite-plugin-devtools-json": "^1.0.0"
  },
  "keywords": [
    "svelte"
  ]
}
